<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:metal="http://xml.zope.org/namespaces/metal"
	xmlns:tal="http://xml.zope.org/namespaces/tal"
	xmlns:i18n="http://xml.zope.org/namespaces/i18n" i18n:domain="medialog.flipbook" metal:use-macro="context/main_template/macros/master">

	<!-- <meta name="viewport" content="width = 1050, user-scalable = no" /> -->


	<body>
		<metal:content fill-slot="main">
			<metal:block define-macro="content">

				<!-- <script type="text/javascript" src="++plone++medialog.flipbook/lib/hash.js"></script> -->
				<script type="text/javascript" src="++plone++medialog.flipbook/lib/turn.min.js"></script>
				<!-- <script type="text/javascript" src="++plone++medialog.flipbook/lib/zoom.min.js"></script> -->
				<!-- <script type="text/javascript" src="++plone++medialog.flipbook/magazine.js"></script> -->
				<!-- <link rel="stylesheet" href="++plone++medialog.flipbook/magazine.css"> -->

			

				<div id="flipbook-container">
					<div id="flipbook">
						<div class="page" tal:repeat="image view/get_images">
							<img tal:attributes="src string:${image/url}/@@images/image/large;
                                   alt image/title;
                                   title image/description" />
						</div>
					</div>
				</div>

				<div class="controls">
					<button id="prev-btn">← Previous</button>
					<span class="page-counter">
						<span id="current-page">1</span> / <span id="total-pages">1</span>
					</span>
					<button id="next-btn">Next →</button>
                    
                  
                
                    
				</div>   <div class="pagination container" id="pagination"></div>
                  
                

                

				<div class="zoom-overlay" id="zoom-overlay">
					<span class="zoom-close" id="zoom-close">×</span>
					<img id="zoomed-image" src="" alt="Zoomed image" />
				</div>

<script>
$(document).ready(function() {
    var $flipbook = $('#flipbook');
    var totalPages = $flipbook.find('.page').length;
    $('#total-pages').text(totalPages);

    // Initialize turn.js
    $flipbook.turn({
        width: $flipbook.width(),
        height: $flipbook.height(),
        autoCenter: true,
        acceleration: true,
        elevation: 50,
        gradients: true,
        when: {
            turned: function(event, page) {
                $('#current-page').text(page);
                updateButtons(page, totalPages);
                createPagination(totalPages, page); // Update pagination on page turn
            }
        }
    });

    // Update Next/Prev buttons
    function updateButtons(page, total) {
        $('#prev-btn').prop('disabled', page === 1);
        $('#next-btn').prop('disabled', page === total);
    }

    // Navigation buttons
    $('#prev-btn').click(function() {
        $flipbook.turn('previous');
    });

    $('#next-btn').click(function() {
        $flipbook.turn('next');
    });

    // Keyboard navigation
    $(document).keydown(function(e) {
        if (e.keyCode === 37) $flipbook.turn('previous'); // Left
        if (e.keyCode === 39) $flipbook.turn('next');     // Right
    });

    // Dynamic pagination for large books
    function createPagination(total, current, maxVisible = 9) {
        var pagination = $('#pagination');
        pagination.empty();

        function addPageButton(page) {
            var btn = $('<button>')
                .addClass('page-btn')
                .text(page)
                .data('page', page)
                .click(function() {
                    $flipbook.turn('page', $(this).data('page'));
                });
            if (page === current) btn.addClass('active');
            pagination.append(btn);
        }

        if (total <= maxVisible) {
            for (var i = 1; i <= total; i++) addPageButton(i);
        } else {
            addPageButton(1); // first page
            var start = Math.max(2, current - Math.floor((maxVisible - 3)/2));
            var end = Math.min(total - 1, current + Math.floor((maxVisible - 3)/2));

            if (start > 2) pagination.append('<span class="ellipsis">...</span>');

            for (var i = start; i <= end; i++) addPageButton(i);

            if (end < total - 1) pagination.append('<span class="ellipsis">...</span>');

            addPageButton(total); // last page
        }
    }

    // Initial setup
    createPagination(totalPages, 1);
    updateButtons(1, totalPages);

    // Zoom functionality (unchanged)
    $('#flipbook .page img').click(function(e) {
        e.stopPropagation();
        var imgSrc = $(this).attr('src').replace('/large', '?full');
        $('#zoomed-image').attr('src', imgSrc);
        $('#zoom-overlay').css('display', 'flex');
    });

    $('#zoom-overlay, #zoom-close, #zoomed-image').click(function() {
        $('#zoom-overlay').hide();
    });

    $('#zoomed-image').click(function(e) {
        e.stopPropagation();
    });

    // Resize handling
    $(window).resize(function() {
        $flipbook.turn('size', $flipbook.parent().width() * 0.9, 
                              $flipbook.parent().height() * 0.85);
    });
});
</script>

					<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: #111;
            font-family: Arial, sans-serif;
            overflow: hidden;
        }
        
        #flipbook-container {
            width: 1200px;
            height: 900px;
            display: flex;
            align-items: center;
            justify-content: center;
            xposition: absolute;
			xleft: 0;
			xright: 0;
        }
        
        #flipbook {
            width: 90%;
            height: 85%;
            <!-- box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8); -->
        }
        
        #flipbook .page {
            display: flex;
            xalign-items: center;
            justify-content: center;
            overflow: hidden;

		}
		.page-wrapper {
			box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8);
        }
        
        #flipbook .page img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            cursor: zoom-in;
			box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8);
        }
        
        #flipbook .page img.zoomed {
            cursor: zoom-out;
            cursor: move;
        }
        
        .controls {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            padding: 9px 12px;
            border-radius: 15px;
            display: flex;
            gap: 15px;
            align-items: center;
            z-index: 1000;
        }
        
        .controls button {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.3s;
        }
        
        .controls button:hover {
            background: #45a049;
        }
        
        .controls button:disabled {
            background: #666;
            cursor: not-allowed;
        }
        
        .page-counter {
            color: white;
            font-size: 16px;
            font-weight: bold;
            min-width: 80px;
            text-align: center;
        }
        
        .zoom-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            cursor: zoom-out;
        }
        
        .zoom-overlay img {
            max-width: 95%;
            max-height: 95%;
            object-fit: contain;
        }
        
        .zoom-close {
            position: absolute;
            top: 20px;
            right: 20px;
            color: white;
            font-size: 40px;
            cursor: pointer;
            z-index: 2001;
        }

        .pagination {
            position: fixed;
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 5px;
            align-items: center;
            z-index: 1000;
            white-space: nowrap;
            z-index: 15
        }

        .pagination .page-btn {
            background: #333;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.3s;
        }

        .pagination .page-btn:hover {
            background: #555;
        }

        .pagination .page-btn.active {
            background: #4CAF50;
            color: white;
            font-weight: bold;
        }

        .pagination .ellipsis {
            color: white;
            padding: 6px 10px;
            font-size: 12px;
        }


				</style>


			</metal:block>
		</metal:content>
	</body>
</html>

